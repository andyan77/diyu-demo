data: {"event":"node_finished","workflow_run_id":"1beff598-8602-46ab-b35c-e767e8962866","task_id":"9fbe7920-7505-4222-9f8a-144b099ba4f7","data":{"id":"b5538740-1e82-4137-814e-da640209770b","node_id":"delivery_finalize","node_type":"code","title":"交付收口","index":1,"predecessor_node_id":null,"inputs":{"adapter_user_delivery":"这一次的发布判断被系统拦下，不能直接使用。\n\n原因：有 9 处事实性陈述的引用编号，在本次登记的事实里找不到对应项：recommended_title —— 情境推荐「后厨里，红烧肉卖了 12 年」；封面小字「老城区·8张桌」 → BRF-HRS-001-A01；recommended_title —— 情境推荐「后厨里，红烧肉卖了 12 年」；发布文案第二行「这道菜，在菜单上放了 12 年」 → BRF-HRS-001-A02；发布文案第一行「后厨里，红烧肉刚出锅」；标签 #本帮菜 → BRF-HRS-001-A03；发布文案正文「自家腌的黄酒糟卤打底」；评论区预埋回答1「自家腌的黄酒糟卤一起烧」 → BRF-HRS-001-A04；评论区置顶首条「这条街上，点这道红烧肉的外卖单子越来越多，也就是这两年的事」 → BRF-HRS-001-A05。按规则，找不到来源的事实性陈述不能进入可发布结果——这不是文案问题，是事实核验没过。\n\n专业判断本身没有丢：完整记录留在内部产出里。需要的是把引用编号核对清楚，或者把对应的事实正式登记进来，然后重新走一次。\n\n这次不算发布就绪，请不要把它当成可以直接使用的结果。","adapter_status":"OK","needs_projection":"false","capability":"PUBLISHING_PACKAGING","fact_gate_blocked":"true","market_claim_blocked":"false","local_block":"true","fact_check_mismatch":"false","release_decision_blocks_delivery":"true"},"inputs_truncated":false,"process_data":{},"process_data_truncated":false,"outputs":{"delivery_outcome":"NOT_DELIVERED_FACT_CHECK_BLOCKED","recovery_used":"false","user_delivery":"这一次的发布判断被系统拦下，不能直接使用。\n\n原因：有 9 处事实性陈述的引用编号，在本次登记的事实里找不到对应项：recommended_title —— 情境推荐「后厨里，红烧肉卖了 12 年」；封面小字「老城区·8张桌」 → BRF-HRS-001-A01；recommended_title —— 情境推荐「后厨里，红烧肉卖了 12 年」；发布文案第二行「这道菜，在菜单上放了 12 年」 → BRF-HRS-001-A02；发布文案第一行「后厨里，红烧肉刚出锅」；标签 #本帮菜 → BRF-HRS-001-A03；发布文案正文「自家腌的黄酒糟卤打底」；评论区预埋回答1「自家腌的黄酒糟卤一起烧」 → BRF-HRS-001-A04；评论区置顶首条「这条街上，点这道红烧肉的外卖单子越来越多，也就是这两年的事」 → BRF-HRS-001-A05。按规则，找不到来源的事实性陈述不能进入可发布结果——这不是文案问题，是事实核验没过。\n\n专业判断本身没有丢：完整记录留在内部产出里。需要的是把引用编号核对清楚，或者把对应的事实正式登记进来，然后重新走一次。\n\n这次不算发布就绪，请不要把它当成可以直接使用的结果。","user_delivery_status":"OK"},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":0.044054,"execution_metadata":null,"created_at":1788411354,"finished_at":1788411354,"files":[],"iteration_id":null,"lo