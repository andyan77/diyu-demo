data: {"event":"node_finished","workflow_run_id":"414507bd-a72a-44de-899e-c80fee0bf806","task_id":"04b71421-38c7-42a0-b8d5-b1776d84a169","data":{"id":"9b34d60e-a244-41bb-903e-7939ebd672b4","node_id":"delivery_finalize","node_type":"code","title":"交付收口","index":1,"predecessor_node_id":null,"inputs":{"adapter_user_delivery":"这一次的发布判断被系统拦下，不能直接使用。\n\n原因：有 10 处事实性陈述的引用编号，在本次登记的事实里找不到对应项：推荐标题「卖了12年的红烧肉，出锅了」 → INPUT-OWNER-FACT-02|INPUT-OWNER-FACT-04；封面「老城区·8张小桌｜一锅红烧肉，第12年」 → INPUT-OWNER-FACT-01|INPUT-OWNER-FACT-02；发布文案第一至三段 → INPUT-OWNER-FACT-01|INPUT-OWNER-FACT-02|INPUT-OWNER-FACT-03|INPUT-OWNER-FACT-06；发布文案「这40秒，就是它每天出锅时的样子」 → INPUT-OWNER-FACT-04；发布文案「没有祖传秘方，也没必要有」 → INPUT-OWNER-FACT-07。按规则，找不到来源的事实性陈述不能进入可发布结果——这不是文案问题，是事实核验没过。\n\n专业判断本身没有丢：完整记录留在内部产出里。需要的是把引用编号核对清楚，或者把对应的事实正式登记进来，然后重新走一次。\n\n这次不算发布就绪，请不要把它当成可以直接使用的结果。","adapter_status":"OK","needs_projection":"false","capability":"PUBLISHING_PACKAGING","fact_gate_blocked":"true","market_claim_blocked":"false","local_block":"true","fact_check_mismatch":"false","release_decision_blocks_delivery":"true"},"inputs_truncated":false,"process_data":{},"process_data_truncated":false,"outputs":{"delivery_outcome":"NOT_DELIVERED_FACT_CHECK_BLOCKED","recovery_used":"false","user_delivery":"这一次的发布判断被系统拦下，不能直接使用。\n\n原因：有 10 处事实性陈述的引用编号，在本次登记的事实里找不到对应项：推荐标题「卖了12年的红烧肉，出锅了」 → INPUT-OWNER-FACT-02|INPUT-OWNER-FACT-04；封面「老城区·8张小桌｜一锅红烧肉，第12年」 → INPUT-OWNER-FACT-01|INPUT-OWNER-FACT-02；发布文案第一至三段 → INPUT-OWNER-FACT-01|INPUT-OWNER-FACT-02|INPUT-OWNER-FACT-03|INPUT-OWNER-FACT-06；发布文案「这40秒，就是它每天出锅时的样子」 → INPUT-OWNER-FACT-04；发布文案「没有祖传秘方，也没必要有」 → INPUT-OWNER-FACT-07。按规则，找不到来源的事实性陈述不能进入可发布结果——这不是文案问题，是事实核验没过。\n\n专业判断本身没有丢：完整记录留在内部产出里。需要的是把引用编号核对清楚，或者把对应的事实正式登记进来，然后重新走一次。\n\n这次不算发布就绪，请不要把它当成可以直接使用的结果。","user_delivery_status":"OK"},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":0.049322,"execution_metadata":null,"created_at":1788415483,"finished_at":1788415483,"files":[],"iteration_id":null,"loop_id":null}}

