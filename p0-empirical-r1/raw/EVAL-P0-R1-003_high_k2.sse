data: {"event":"node_finished","workflow_run_id":"af718448-43b1-44f7-9748-6440a9241352","task_id":"3b3a503b-c2a7-4ba4-9929-37ff66eeff69","data":{"id":"9871832f-b384-4bd0-a2f0-a413ea2fe3b3","node_id":"delivery_finalize","node_type":"code","title":"交付收口","index":1,"predecessor_node_id":null,"inputs":{"adapter_user_delivery":"这一次的发布判断被系统拦下，不能直接使用。\n\n原因：有 4 处事实性陈述的引用编号，在本次登记的事实里找不到对应项：推荐标题/封面大字“帐篷漏了那晚，我们没撤” → 用户原话“帐篷有一处接缝真的漏了水，这个我打算老实说；那晚我们没有因为小雨撤离” —— 上游未提供 fact_refs 登记号；发布文案“周末去城市周边住了一晚 / 帐篷真的漏了 / 但那时我们没想走” → 用户原话“上周末去附近山里扎营”“中途下了一阵小雨”“帐篷有一处接缝真的漏了水” —— 上游未提供 fact_refs 登记号；评论区预埋问答中“1.2kg 化纤睡袋” → 用户原话“睡袋是化纤材质，大概1.2kg，这个是买的时候记下来的” —— 上游未提供 fact_refs 登记号；包装上限“城市周边一日往返露营，遇到小雨和帐篷渗漏但未被劝退” → 用户原话“城市周边一日往返的露营路线”“中途下了一阵小雨”“帐篷有一处接缝真的漏了水” —— 上游未提供 fact_refs 登记号。按规则，找不到来源的事实性陈述不能进入可发布结果——这不是文案问题，是事实核验没过。\n\n专业判断本身没有丢：完整记录留在内部产出里。需要的是把引用编号核对清楚，或者把对应的事实正式登记进来，然后重新走一次。\n\n这次不算发布就绪，请不要把它当成可以直接使用的结果。","adapter_status":"OK","needs_projection":"false","capability":"PUBLISHING_PACKAGING","fact_gate_blocked":"true","market_claim_blocked":"false","local_block":"true","fact_check_mismatch":"true","release_decision_blocks_delivery":"true"},"inputs_truncated":false,"process_data":{},"process_data_truncated":false,"outputs":{"delivery_outcome":"NOT_DELIVERED_FACT_CHECK_BLOCKED","recovery_used":"false","user_delivery":"这一次的发布判断被系统拦下，不能直接使用。\n\n原因：有 4 处事实性陈述的引用编号，在本次登记的事实里找不到对应项：推荐标题/封面大字“帐篷漏了那晚，我们没撤” → 用户原话“帐篷有一处接缝真的漏了水，这个我打算老实说；那晚我们没有因为小雨撤离” —— 上游未提供 fact_refs 登记号；发布文案“周末去城市周边住了一晚 / 帐篷真的漏了 / 但那时我们没想走” → 用户原话“上周末去附近山里扎营”“中途下了一阵小雨”“帐篷有一处接缝真的漏了水” —— 上游未提供 fact_refs 登记号；评论区预埋问答中“1.2kg 化纤睡袋” → 用户原话“睡袋是化纤材质，大概1.2kg，这个是买的时候记下来的” —— 上游未提供 fact_refs 登记号；包装上限“城市周边一日往返露营，遇到小雨和帐篷渗漏但未被劝退” → 用户原话“城市周边一日往返的露营路线”“中途下了一阵小雨”“帐篷有一处接缝真的漏了水” —— 上游未提供 fact_refs 登记号。按规则，找不到来源的事实性陈述不能进入可发布结果——这不是文案问题，是事实核验没过。\n\n专业判断本身没有丢：完整记录留在内部产出里。需要的是把引用编号核对清楚，或者把对应的事实正式登记进来，然后重新走一次。\n\n这次不算发布就绪，请不要把它当成可以直接使用的结果。","user_delivery_status":"OK"},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":0.052228,"execution_metadata":null,"created_at":1788416384,"finished_at":1788416384,"files":[],"iteration_id":null,"loop_id":null}}

