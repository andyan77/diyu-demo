data: {"event":"node_finished","workflow_run_id":"dd6474eb-ea25-4475-8296-5c1012b51bc4","task_id":"cd828530-c732-4aec-b7d6-b4fefc05c178","data":{"id":"b272de09-021b-4746-8a86-25447a5c6bea","node_id":"delivery_finalize","node_type":"code","title":"交付收口","index":1,"predecessor_node_id":null,"inputs":{"adapter_user_delivery":"这一次的发布判断被系统拦下，不能直接使用。\n\n原因：FACT_LEDGER 声明 NONE（本次没有需要登记的事实性陈述），但用户正文里出现疑似事实性数据（1.2kg、1.2kg），与 NONE 声明矛盾。按规则，找不到来源的事实性陈述不能进入可发布结果——这不是文案问题，是事实核验没过。\n\n专业判断本身没有丢：完整记录留在内部产出里。需要的是把引用编号核对清楚，或者把对应的事实正式登记进来，然后重新走一次。\n\n这次不算发布就绪，请不要把它当成可以直接使用的结果。","adapter_status":"OK","needs_projection":"false","capability":"PUBLISHING_PACKAGING","fact_gate_blocked":"true","market_claim_blocked":"false","local_block":"true","fact_check_mismatch":"true","release_decision_blocks_delivery":"true"},"inputs_truncated":false,"process_data":{},"process_data_truncated":false,"outputs":{"delivery_outcome":"NOT_DELIVERED_FACT_CHECK_BLOCKED","recovery_used":"false","user_delivery":"这一次的发布判断被系统拦下，不能直接使用。\n\n原因：FACT_LEDGER 声明 NONE（本次没有需要登记的事实性陈述），但用户正文里出现疑似事实性数据（1.2kg、1.2kg），与 NONE 声明矛盾。按规则，找不到来源的事实性陈述不能进入可发布结果——这不是文案问题，是事实核验没过。\n\n专业判断本身没有丢：完整记录留在内部产出里。需要的是把引用编号核对清楚，或者把对应的事实正式登记进来，然后重新走一次。\n\n这次不算发布就绪，请不要把它当成可以直接使用的结果。","user_delivery_status":"OK"},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":0.047386,"execution_metadata":null,"created_at":1788416176,"finished_at":1788416176,"files":[],"iteration_id":null,"loop_id":null}}

