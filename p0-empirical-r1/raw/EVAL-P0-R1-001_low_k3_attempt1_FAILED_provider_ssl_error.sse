data: {"event":"node_finished","workflow_run_id":"44a1032f-e192-40cb-9b43-49180a4800c3","task_id":"50f68799-1367-409e-b544-f93b6f3246bb","data":{"id":"b32a4395-8678-46b0-86a6-3a5c477b6396","node_id":"projection_record","node_type":"template-transform","title":"Projection Record","index":1,"predecessor_node_id":null,"inputs":{"subject_domain":"餐饮 / 门店","example_reference_requested":""},"inputs_truncated":false,"process_data":{},"process_data_truncated":false,"outputs":{"output":"{\n  \"capability\": \"PUBLISHING_PACKAGING\",\n  \"loaded_reference_sections\": [\n    \"SKILL.md :: 后继版全文（始终加载）\"\n    ,\"platforms.md :: 全文（无条件加载）\"\n    ,\"industry-conditions.md :: 餐饮 / 门店\"\n  ],\n  \"load_matrix_ref\": \"V1_M4_UNIFIED_CAPABILITY_CONTRACT_v0.1.md §12\",\n  \"second_attachment_library_built\": false,\n  \"rag_first_layer_built\": false,\n  \"reference_embedding_method\": \"DSL 构建期字节快照嵌入（与 system prompt 自身的生成方式同构），非运行时检索/HTTP/知识库\",\n  \"reference_provenance\": {\n    \"platforms_md\": {\n      \"path\": \"content-production/skills/packaging-content-for-release/references/platforms.md\",\n      \"sha256\": \"86fc2cc7231e4f0457253668900e99fbc03fd0bfabe9219902ee849502405727\",\n      \"embedded_at\": \"2026-09-01\",\n      \"loaded_this_run\": true\n    },\n    \"industry_conditions_md\": {\n      \"path\": \"content-production/skills/packaging-content-for-release/references/industry-conditions.md\",\n      \"sha256_full_file\": \"b085f1218a561adb500980464325c4356413187ee6e45be5430d5d1334fb7f6d\",\n      \"embedded_at\": \"2026-09-01\",\n      \"loaded_this_run\": true,\n      \"loaded_section\": \"餐饮 / 门店\"\n    },\n    \"examples_md\": {\n      \"path\": \"content-production/skills/packaging-content-for-release/references/examples.md\",\n      \"sha256\": \"635c86e11ab9bd4e6e1b1fb721b2e3929f8a57c8a18c64f57dc81d743228f3e5\",\n      \"embedded_at\": \"2026-09-01\",\n      \"loaded_this_run\": false,\n      \"reason\": \"本次未显式请求案例参考\"\n    }\n  },\n  \"remediation_task_id\": \"DIYU-V1-PP-BLOCKER-REMEDIATION-S1-S4-001\",\n  \"closes\": \"B-03\"\n}"},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":0.090742,"execution_metadata":null,"created_at":1788413305,"finished_at":1788413305,"files":[],"iteration_id":null,"loop_id":null}}

