data: {"event":"workflow_started","workflow_run_id":"44a1032f-e192-40cb-9b43-49180a4800c3","task_id":"50f68799-1367-409e-b544-f93b6f3246bb","data":{"id":"44a1032f-e192-40cb-9b43-49180a4800c3","workflow_id":"271fae0b-90d0-4803-8b0d-38edc6b0f79f","inputs":{"capability_call":"cta_level: LOW_RISK_INTERACTION","professional_input":"我们是做本帮红烧肉的小饭馆，就开在老城区那条巷子里，8张桌子。已经拍了一段红烧肉出锅的过程，大概40秒，这个月想发抖音，勾一下食欲。这道菜我们家已经卖了十二年了，用的是自己家腌的黄酒糟卤打底，这两年在美团上一直是那条街同类菜系销量第一。红烧肉用的五花肉是本地菜场买的，质检合格证都留着。想让观众知道这道菜真的是老手艺，不是随便炒的，看完能来店里尝一下，最好能顺便办张储值卡，不办卡也没关系，别老逼着人办卡就行。不能说什么祖传秘方，我们家开店才十二年，说祖传不合适。素材是我自己拍的，都在后厨，没有别人出镜，可以随便发。","example_reference_requested":"","sys.files":[],"sys.user_id":"e4-r1-eval-p0-r1-001-low-k3","sys.app_id":"0c728729-8c0e-4182-b0e5-3b7d893eeecc","sys.workflow_id":"271fae0b-90d0-4803-8b0d-38edc6b0f79f","sys.workflow_run_id":"44a1032f-e192-40cb-9b43-49180a4800c3"},"created_at":1788413304,"reason":"initial"}}

