data: {"event":"node_finished","workflow_run_id":"ad8ddc5c-033b-4837-a6ea-6a39d58f6626","task_id":"34329679-cfb1-46e9-959a-59f07ab8842a","data":{"id":"5877660c-5f55-4b55-b83d-6ed9f761ccec","node_id":"envelope_check","node_type":"code","title":"外壳校验","index":1,"predecessor_node_id":null,"inputs":{"capability_call":"","professional_input":"这条是我们上周末去附近山里扎营的一次记录，已经拍完了这条露营记录的素材，想发视频号。主要想让观众知道我们这种城市周边一日往返的露营路线是真的可行的，不需要专业装备也能出门，没有任何购买链接，也不引导大家去买什么装备，就是单纯记录分享。出镜的就我一个人，视频是我自己拍的，没有别人。这次天气不算好，中途下了一阵小雨，帐篷有一处接缝真的漏了水，这个我打算老实说，不想吹得云淡风轻。睡袋是化纤材质，大概1.2kg，这个是买的时候记下来的。不确定的东西我不会瞎讲，比如这顶帐篷具体防水等级多少我没查过，就不提了。","example_reference_requested":""},"inputs_truncated":false,"process_data":{},"process_data_truncated":false,"outputs":{"can_run":"true","capability":"PUBLISHING_PACKAGING","conditionalized_text":"objective.goal_family 未声明：不得代为推断，按未声明处理并在产出中标注","cta_level":"NO_CTA","cta_level_declared_illegal":"false","duration_band":"SHORT","equivalence_basis":"NOT_STATED","example_reference_requested":"","goal_family":"UNDECLARED","missing":[],"missing_text":"无","note":"结构性充分","platform":"视频号","source_kind":"UNDECLARED","status":"SUFFICIENT","subject_domain":"户外 / 露营（爱好垂类）","vacuity_flags":[]},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":0.053577,"execution_metadata":null,"created_at":1788413856,"finished_at":1788413856,"files":[],"iteration_id":null,"loop_id":null}}

