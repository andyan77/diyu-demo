data: {"event":"workflow_started","workflow_run_id":"ad8ddc5c-033b-4837-a6ea-6a39d58f6626","task_id":"34329679-cfb1-46e9-959a-59f07ab8842a","data":{"id":"ad8ddc5c-033b-4837-a6ea-6a39d58f6626","workflow_id":"271fae0b-90d0-4803-8b0d-38edc6b0f79f","inputs":{"capability_call":"","professional_input":"这条是我们上周末去附近山里扎营的一次记录，已经拍完了这条露营记录的素材，想发视频号。主要想让观众知道我们这种城市周边一日往返的露营路线是真的可行的，不需要专业装备也能出门，没有任何购买链接，也不引导大家去买什么装备，就是单纯记录分享。出镜的就我一个人，视频是我自己拍的，没有别人。这次天气不算好，中途下了一阵小雨，帐篷有一处接缝真的漏了水，这个我打算老实说，不想吹得云淡风轻。睡袋是化纤材质，大概1.2kg，这个是买的时候记下来的。不确定的东西我不会瞎讲，比如这顶帐篷具体防水等级多少我没查过，就不提了。","example_reference_requested":"","sys.files":[],"sys.user_id":"e4-r1-eval-p0-r1-003-low-k3","sys.app_id":"0c728729-8c0e-4182-b0e5-3b7d893eeecc","sys.workflow_id":"271fae0b-90d0-4803-8b0d-38edc6b0f79f","sys.workflow_run_id":"ad8ddc5c-033b-4837-a6ea-6a39d58f6626"},"created_at":1788413856,"reason":"initial"}}

