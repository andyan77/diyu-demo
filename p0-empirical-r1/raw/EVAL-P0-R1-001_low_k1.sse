data: {"event":"node_finished","workflow_run_id":"bfde2811-2c6e-42d4-922a-4526e733e0c3","task_id":"c7ab951f-8f10-44a2-85f6-67b19e493045","data":{"id":"41ffbd0e-e21c-411c-8769-0f6dfcb4a0b2","node_id":"delivery_finalize","node_type":"code","title":"交付收口","index":1,"predecessor_node_id":null,"inputs":{"adapter_user_delivery":"这一次的发布判断被系统拦下，不能直接使用。\n\n原因：有 7 处事实性陈述，在用户原文里找不到实质对应内容：标题候选 “卖了十二年的红烧肉，出锅了” 及发布文案首行 → 「该店红烧肉已售卖十二年」；发布文案开头第一行 → 「门店是老城区巷内八张桌小馆，售卖本帮红烧肉」；发布文案开头第三行 → 「这两年美团上同一条街同类菜系销量第一」；发布文案正文第二段 → 「五花肉在本地菜场购买且质检合格证留存店中」；评论预埋问答及作者回复 → 「红烧肉底味为自家腌黄酒糟卤」。按规则，找不到来源的事实性陈述不能进入可发布结果——这不是文案问题，是事实核验没过。\n\n专业判断本身没有丢：完整记录留在内部产出里。需要的是把这几处事实性陈述改成用户原文真的说过的内容，或者补充真实依据后重新走一次。\n\n这次不算发布就绪，请不要把它当成可以直接使用的结果。","adapter_status":"OK","needs_projection":"false","capability":"PUBLISHING_PACKAGING","fact_gate_blocked":"true","market_claim_blocked":"false","local_block":"true","fact_check_mismatch":"false","release_decision_blocks_delivery":"true"},"inputs_truncated":false,"process_data":{},"process_data_truncated":false,"outputs":{"delivery_outcome":"NOT_DELIVERED_FACT_CHECK_BLOCKED","recovery_used":"false","user_delivery":"这一次的发布判断被系统拦下，不能直接使用。\n\n原因：有 7 处事实性陈述，在用户原文里找不到实质对应内容：标题候选 “卖了十二年的红烧肉，出锅了” 及发布文案首行 → 「该店红烧肉已售卖十二年」；发布文案开头第一行 → 「门店是老城区巷内八张桌小馆，售卖本帮红烧肉」；发布文案开头第三行 → 「这两年美团上同一条街同类菜系销量第一」；发布文案正文第二段 → 「五花肉在本地菜场购买且质检合格证留存店中」；评论预埋问答及作者回复 → 「红烧肉底味为自家腌黄酒糟卤」。按规则，找不到来源的事实性陈述不能进入可发布结果——这不是文案问题，是事实核验没过。\n\n专业判断本身没有丢：完整记录留在内部产出里。需要的是把这几处事实性陈述改成用户原文真的说过的内容，或者补充真实依据后重新走一次。\n\n这次不算发布就绪，请不要把它当成可以直接使用的结果。","user_delivery_status":"OK"},"outputs_truncated":false,"status":"succeeded","error":null,"elapsed_time":0.044967,"execution_metadata":null,"created_at":1788423537,"finished_at":1788423537,"files":[],"iteration_id":null,"loop_id":null}}

