{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diyu.local/schemas/M3_TO_M2_WRITEBACK_CANDIDATE_v1.0.schema.json",
  "title": "M3 → M2 运营判断、周期计划与复盘更新候选写回接缝",
  "description": "M3 只产出候选。是否接受、哪个版本成为当前有效版本，由 M2 与用户按已接受的写回权限合同裁决。本信封刻意做成「无法表达接受」：candidate_status 只有一个取值，且 forbidden_keys 在校验期整树拒绝任何把候选直接晋升、覆盖原始反馈或改写来源的字段。suggested_m2_endpoint 只是给编排层的提示——真正发起 POST 的是 Workflow，不是 Skill；M3 侧不持有端点凭据。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "produced_at",
    "binding",
    "candidate_status",
    "candidate_kind",
    "rationale",
    "based_on",
    "payload",
    "affects"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "candidate_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "produced_at": { "type": "string" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "account_id", "projection_id"],
      "properties": {
        "workspace_id": { "type": "string", "minLength": 1 },
        "account_id": { "type": "string", "minLength": 1 },
        "projection_id": {
          "type": "string",
          "minLength": 1,
          "description": "指回它所依据的那一轮投影。投影变化即候选置 STALE。"
        },
        "cycle_id": { "type": ["string", "null"] },
        "skill_version": { "type": ["string", "null"] },
        "model_ref": {
          "type": ["string", "null"],
          "description": "provider + 准确 model id + 参数摘要。缺失时不得声称 Runtime 保真。"
        }
      }
    },
    "candidate_status": {
      "const": "proposed",
      "description": "唯一合法取值。没有 accepted / current / promoted —— 这三种状态不属于 M3，信封在语法层就无法表达它们。"
    },
    "candidate_kind": {
      "enum": [
        "diagnosis",
        "cycle_plan",
        "content_task_set",
        "review_update",
        "no_content_task"
      ],
      "description": "四类候选 + 合法无任务结论。刻意不与四类业务行为一一对应——一次调用可以同时产出诊断与周期计划两个候选。"
    },
    "rationale": { "type": "string", "minLength": 1 },
    "based_on": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "evidence_identity"],
        "properties": {
          "ref": { "type": "string" },
          "evidence_identity": {
            "enum": [
              "user_statement",
              "confirmed_fact",
              "professional_judgment",
              "provisional_hypothesis",
              "real_publication_observation",
              "manual_platform_note",
              "manual_business_outcome",
              "external_market_observation",
              "simulated_or_test_feedback",
              "unknown"
            ],
            "description": "十类证据身份不得互相顶替。模拟/测试反馈永远不能单独支撑真实市场有效性结论。"
          },
          "note": { "type": ["string", "null"] }
        }
      },
      "description": "至少一条。没有依据的候选不是判断。"
    },
    "payload": {
      "type": "object",
      "description": "候选的业务内容。结构随 candidate_kind 变化，刻意不冻结为固定表结构——M2 原样存储，不评判（已由 M2 契约测试钉死）。校验期对整树执行禁词反搜。"
    },
    "affects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invalidates", "explicitly_unchanged"],
      "properties": {
        "invalidates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "真实依赖该语义、且尚未发布的任务。已发布内容保留为历史，不得出现在这里。"
        },
        "explicitly_unchanged": {
          "type": "array",
          "items": { "type": "string" },
          "description": "明确保持不变的判断。空着与「没想过」不可区分，所以这一项必填。"
        },
        "stale_unknown_impact": {
          "type": "array",
          "items": { "type": "string" },
          "description": "影响关系无法判断的项。标 STALE 待定向复验不算少算；假装知道依赖图才是错。"
        }
      }
    },
    "no_content_task": {
      "$ref": "#/definitions/no_content_task",
      "description": "candidate_kind = no_content_task 时必填（由 validate_writeback_candidate 强制）。"
    },
    "suggested_m2_endpoint": {
      "enum": [
        "POST /workspaces/{workspace_id}/cycles",
        "POST /workspaces/{workspace_id}/accounts/{account_id}/cycles/decisions",
        "POST /workspaces/{workspace_id}/playbooks",
        "POST /workspaces/{workspace_id}/campaign-overrides",
        "NONE"
      ],
      "description": "只是提示。全部是 M2 已有端点——本任务不要求 M2 改动。NONE 表示这个候选本轮不落库（例如纯诊断）。"
    }
  },
  "definitions": {
    "no_content_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "grounded_in", "scope", "reopen_trigger"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "具体理由。「信息不足」这类无类别表述不满足本项。"
        },
        "grounded_in": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "理由依据的事实与类别。"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["affected", "unaffected"],
          "properties": {
            "affected": { "type": "array", "items": { "type": "string" } },
            "unaffected": {
              "type": "array",
              "items": { "type": "string" },
              "description": "明确不受影响的范围。写不出它，说明这是全局硬停而不是局部结论。"
            }
          }
        },
        "reopen_trigger": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "什么条件出现就重新判断。无触发器的无任务结论等于放弃工作。"
        }
      }
    }
  }
}
